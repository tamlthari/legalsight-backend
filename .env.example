# Copy this file to .env and set the values for local backend development.
APP_ENV=development
APP_SECRET_KEY=change-me-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000
POSTGRES_USER=legal_vag
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=legal_vag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
AWS_REGION=ap-southeast-1
S3_BUCKET=replace-with-your-bucket
S3_PREFIX=legal-vag
TEXTRACT_COMPLETION_MODE=poll
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4.1-mini
EMBEDDING_DIMENSION=1536
PINECONE_API_KEY=
PINECONE_INDEX=legal-vag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

